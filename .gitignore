# Build output
artifacts/

# Bundled engine copied into the module at build time (source of truth lives in
# scripts4PythonAutomation/). Never commit the generated copy.
PythonVenvAutomation/engine/

# Python bytecode caches
__pycache__/
*.py[cod]

# Test/coverage output written by Run-Tests.ps1
test-results.xml
coverage.xml

# Python virtual environment
.venv/
.setup-config.json

# Generated runtime state (only ever created under %LOCALAPPDATA%, but ignore
# any stray local copies)
config.json
update.lock

# OS / editor noise
.DS_Store
Thumbs.db
